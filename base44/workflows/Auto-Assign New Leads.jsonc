{
  "name": "Auto-Assign New Leads",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.assigned_consultant == null or .trigger.data.assigned_consultant == \"\" or .trigger.data.assigned_consultant == [] or .trigger.data.assigned_consultant == {}) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_assign_new_leads",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "assignLeadToConsultant",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "assignLeadToConsultant"
  }
}